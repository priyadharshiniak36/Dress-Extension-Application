# Server-only secret. Never prefix with NEXT_PUBLIC_.
DECART_API_KEY=

# Comma-separated origins allowed to mint tokens in production (e.g. https://tryanything.app).
# In development the page's own origin (https://localhost:3000, https://<LAN-IP>:3000) is accepted automatically.
APP_ORIGINS=https://localhost:3000

# Optional tuning
DECART_MODEL=lucy-vton-latest
DECART_SCOPE_TOKEN_TO_MODEL=false
DECART_TOKEN_TTL_SECONDS=60
DECART_MAX_SESSION_SECONDS=180

# Public consent links
NEXT_PUBLIC_TERMS_URL=/legal/terms
NEXT_PUBLIC_PRIVACY_URL=/legal/privacy
NEXT_PUBLIC_AUP_URL=/legal/aup

# Try-on mode: ai = Decart live AI (default; needs credits, auto-falls back to free); free = on-device overlay (no cost)
NEXT_PUBLIC_DEFAULT_MODE=ai

# Extra hosts allowed in the production CSP connect-src (space-separated, https:// or wss://), if the browser console shows a CSP refusal
CSP_CONNECT_EXTRA=

# Optional: realistic photo try-on via Google Gemini (server-only secret from aistudio.google.com/apikey; image output is billed, ~$0.03-0.05 per photo)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Daily cap on photos per server instance (spend guard)
GEMINI_DAILY_LIMIT=100

# Self-hosted CatVTON try-on server (see tryon-server/README.md). NON-COMMERCIAL licence (CC BY-NC-SA 4.0).
# Must be https:// (http://localhost allowed for development). Token must match TRYON_TOKEN on the server.
CATVTON_URL=
CATVTON_TOKEN=
# catvton | gemini. Optional: by default CatVTON is used when configured, otherwise Gemini.
TRYON_PROVIDER=
